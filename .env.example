# ─── Aplicación ───────────────────────────────────────────────
APP_NAME="Plataforma Inmobiliaria"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=80
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ─── Logs ─────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Base de datos (Sail: servicio "mysql") ──────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=inmobiliaria
DB_USERNAME=sail
DB_PASSWORD=password
FORWARD_DB_PORT=3306

# ─── Sesión / cache / colas ───────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

# ─── Redis (Sail: servicio "redis") ───────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6379

# ─── Correo (Sail: Mailpit, UI en http://localhost:8025) ──────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@inmobiliaria.test"
MAIL_FROM_NAME="${APP_NAME}"
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# ─── Almacenamiento (local en dev; S3-compatible en prod) ─────
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Frontend ─────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_PORT=5173

# ─── Sail ─────────────────────────────────────────────────────
WWWUSER=1000
WWWGROUP=1000
